-- ==================== HELPERS ====================
local function GetClosest()
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, math.huge end
    local best, dist = nil, math.huge
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            if not (plr.Team and LP.Team and plr.Team == LP.Team) then
                local d = (plr.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
                if d < dist then dist = d; best = plr end
            end
        end
    end
    return best, dist
end

-- Большой 3D зонтик
local function MakeUmbrella(head)
    if head:FindFirstChild("FindMyUmbrella") then head.FindMyUmbrella:Destroy() end
    local model = Instance.new("Model")
    model.Name = "FindMyUmbrella"
    model.Parent = head

    local handle = Instance.new("Part")
    handle.Size = Vector3.new(0.25, 2.8, 0.25)
    handle.Color = Color3.fromRGB(30, 30, 30)
    handle.Material = Enum.Material.SmoothPlastic
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = model

    local top = Instance.new("Part")
    top.Size = Vector3.new(5.5, 0.6, 5.5)
    top.Color = Color3.fromRGB(0, 255, 100)
    top.Material = Enum.Material.Neon
    top.CanCollide = false
    top.Massless = true
    top.Parent = model
    local mesh = Instance.new("SpecialMesh", top)
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Scale = Vector3.new(1, 0.28, 1)

    local w1 = Instance.new("Weld")
    w1.Part0 = head
    w1.Part1 = handle
    w1.C0 = CFrame.new(0, 3.6, 0)
    w1.Parent = handle

    local w2 = Instance.new("Weld")
    w2.Part0 = handle
    w2.Part1 = top
    w2.C0 = CFrame.new(0, 1.5, 0)
    w2.Parent = top
end

-- Skeleton
local SkeletonFolder = Instance.new("Folder", workspace)
SkeletonFolder.Name = "FindMySkeleton"

local function ClearSkeleton()
    for _, v in pairs(SkeletonFolder:GetChildren()) do v:Destroy() end
end

local function DrawBone(p0, p1, color)
    local a0 = Instance.new("Attachment", p0)
    local a1 = Instance.new("Attachment", p1)
    local beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.Width0 = 0.06
    beam.Width1 = 0.06
    beam.Color = ColorSequence.new(color or Color3.fromRGB(0, 255, 140))
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.Transparency = NumberSequence.new(0.1)
    beam.Parent = SkeletonFolder
    beam.Destroying:Connect(function() a0:Destroy(); a1:Destroy() end)
end

local function MakeSkeleton(char)
    ClearSkeleton()
    local parts = {
        {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
        -- R6 fallback
        {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
    }
    for _, pair in ipairs(parts) do
        local a, b = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
        if a and b then DrawBone(a, b) end
    end
end

