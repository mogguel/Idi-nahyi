-- ==================== SILENT AIM (без поворота камеры) ====================
-- Перехватываем Mouse.Hit / Mouse.Target чтобы пули летели в цель
local silentTargetPart = nil

pcall(function()
    local mt = getrawmetatable(game)
    local oldIndex = mt.__index
    setreadonly(mt, false)

    mt.__index = newcclosure(function(self, key)
        if S.SilentAim and silentTargetPart and silentTargetPart.Parent then
            if self == Mouse and key == "Hit" then
                return silentTargetPart.CFrame
            end
            if self == Mouse and key == "Target" then
                return silentTargetPart
            end
        end
        return oldIndex(self, key)
    end)

    setreadonly(mt, true)
end)

-- Дополнительно: хук Raycast (если игра использует workspace:Raycast)
pcall(function()
    local mt = getrawmetatable(workspace)
    if not mt then return end
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if S.SilentAim and silentTargetPart and silentTargetPart.Parent then
            if method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
                local args = {...}
                -- не ломаем вызов, просто стараемся направить через Mouse.Hit
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end)

-- ==================== MAIN LOOP ====================
RunService.RenderStepped:Connect(function()
    ClearTracers()
    ClearSkeleton()

    local enemy, dist = GetClosest()
    Closest = enemy

    -- Silent aim target (голова), камера НЕ двигается
    if S.SilentAim and enemy and enemy.Character then
        silentTargetPart = enemy.Character:FindFirstChild("Head") or enemy.Character:FindFirstChild("HumanoidRootPart")
    else
        silentTargetPart = nil
    end

    -- Aimbot — только если включён отдельно (двигает камеру)
    if S.Aimbot and enemy and enemy.Character and not Checking then
        local part = enemy.Character:FindFirstChild("Head") or enemy.Character:FindFirstChild("HumanoidRootPart")
        if part then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, part.Position)
        end
    end

    Alert.Visible = S.EnemyAlert and enemy and dist <= 15

    if enemy and enemy.Character then
        local head = enemy.Character:FindFirstChild("Head")
        local hrp = enemy.Character:FindFirstChild("HumanoidRootPart")

        if S.Umbrella and head then
            if not head:FindFirstChild("FindMyUmbrella") then
                MakeUmbrella(head)
            end
        elseif head and head:FindFirstChild("FindMyUmbrella") then
            head.FindMyUmbrella:Destroy()
        end

        if S.Tracers and hrp and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            MakeTracer(LP.Character.HumanoidRootPart, hrp)
        end

        if S.Skeleton then
            MakeSkeleton(enemy.Character)
        end

        if S.HPBar then
            MakeHPBar(enemy.Character)
        elseif head and head:FindFirstChild("FindMyHP") then
            head.FindMyHP:Destroy()
        end
    end

    -- Speed
    if S.SpeedEnabled and LP.Character and LP.Character:FindFirstChild("Humanoid") then
        LP.Character.Humanoid.WalkSpeed = S.Speed
    end

    -- Fly
    if S.Fly and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LP.Character.HumanoidRootPart
        if not flyBV or not flyBV.Parent then
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            flyBV.Parent = hrp
        end
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.yAxis end
        flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * S.FlySpeed or Vector3.zero
    else
        if flyBV then flyBV:Destroy(); flyBV = nil end
    end
end)

-- X-Ray только стены / пол / потолок (не персонажи, не оружие)
task.spawn(function()
    while task.wait(0.5) do
        if S.XRay then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and not obj:IsDescendantOf(LP.Character) then
                    local isPlayer = false
                    for _, plr in pairs(Players:GetPlayers()) do
                        if plr.Character and obj:IsDescendantOf(plr.Character) then
                            isPlayer = true
                            break
                        end
                    end
                    if not isPlayer then
                        if not xraySaved[obj] then
                            xraySaved[obj] = obj.Transparency
                        end
                        if obj.Transparency < 0.85 then
                            obj.Transparency = 0.9
                        end
                    end
                end
            end
        else
            for part, old in pairs(xraySaved) do
                if part and part.Parent then
                    part.Transparency = old
                end
            end
            xraySaved = {}
        end
    end
end)

